<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No permissions on purpose. Photo Picker handles reading,
         MediaStore or the system folder picker handles writing,
         and there is no network access. -->

    <!--
        allowBackup="false" turns off backup on every supported version, so the
        fullBackupContent file lint asks for would be dead configuration. The
        extraction rules are still declared because they additionally opt out
        of device-to-device transfer, which is not covered by allowBackup.
    -->
    <application
        tools:ignore="DataExtractionRules"
        android:name=".app.MetaStripApp"
        android:allowBackup="false"
        android:largeHeap="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MetaStrip">

        <activity
            android:name=".app.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lets other apps share an image directly into MetaStrip -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".app.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".app.MainActivity" />
    </application>
</manifest>
